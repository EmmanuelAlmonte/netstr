# Netstr runtime contract for host-native installs
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8086

# Reverse-proxy safety: keep redirects off when TLS terminates at nginx.
Connection__UseHttpsRedirection=false
Connection__UseForwardedHeaders=true
Connection__WebSocketsPath=/

# Deterministic runtime paths (overridable)
NETSTR_CONFIG_DIR=/etc/netstr
NETSTR_DATA_DIR=/var/lib/netstr
NETSTR_LOG_DIR=/var/log/netstr

# PostgreSQL (required)
ConnectionStrings__NetstrDatabase=Host=127.0.0.1;Port=5432;Database=Netstr;Username=netstr;Password=change-me

# Relay metadata (maps 1:1 to Relay Wizard prompt values)
RelayInformation__Name=netstr relay
RelayInformation__Description=A nostr relay
RelayInformation__PublicKey=NA
RelayInformation__Contact=ops@example.com
RelayInformation__Version=v0.0.0
